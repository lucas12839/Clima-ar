from __future__ import annotations

import torch
import torch.nn as nn


class ResidualBlock(nn.Module):
    def __init__(self, channels: int):
        super().__init__()
        self.block = nn.Sequential(
            nn.Conv2d(channels, channels, 3, padding=1, bias=False),
            nn.BatchNorm2d(channels),
            nn.GELU(),
            nn.Conv2d(channels, channels, 3, padding=1, bias=False),
            nn.BatchNorm2d(channels),
        )
        self.act = nn.GELU()

    def forward(self, x):
        return self.act(x + self.block(x))


class RMA10SpatialTemporalEncoder(nn.Module):
    def __init__(self, in_channels=2, base_channels=32, out_channels=128):
        super().__init__()

        self.stem = nn.Sequential(
            nn.Conv2d(in_channels, base_channels, 3, padding=1, bias=False),
            nn.BatchNorm2d(base_channels),
            nn.GELU(),
        )

        self.down1 = nn.Sequential(
            nn.Conv2d(base_channels, 64, 3, stride=2, padding=1, bias=False),
            nn.BatchNorm2d(64),
            nn.GELU(),
            ResidualBlock(64),
        )

        self.down2 = nn.Sequential(
            nn.Conv2d(64, out_channels, 3, stride=2, padding=1, bias=False),
            nn.BatchNorm2d(out_channels),
            nn.GELU(),
            ResidualBlock(out_channels),
        )

        self.temporal_attention = nn.MultiheadAttention(
            embed_dim=out_channels,
            num_heads=8,
            batch_first=True,
        )

        self.norm = nn.LayerNorm(out_channels)

    def forward(self, x):
        if x.ndim != 5:
            raise ValueError(
                f"Entrada esperada [B,T,C,H,W], recibida {tuple(x.shape)}"
            )

        b, t, c, h, w = x.shape

        x = x.reshape(b * t, c, h, w)
        x = self.stem(x)
        x = self.down1(x)
        x = self.down2(x)

        _, channels, h2, w2 = x.shape

        tokens = x.mean(dim=(2, 3)).reshape(b, t, channels)

        attn, _ = self.temporal_attention(
            tokens, tokens, tokens, need_weights=False
        )

        temporal_context = self.norm(attn[:, -1])

        feature_map = x.reshape(
            b, t, channels, h2, w2
        )[:, -1]

        return {
            "feature_map": feature_map,
            "temporal_context": temporal_context,
        }


def build_model():
    return RMA10SpatialTemporalEncoder()


if __name__ == "__main__":
    model = build_model()
    x = torch.randn(1, 6, 2, 128, 128)

    with torch.no_grad():
        out = model(x)

    print("RMA10 ENCODER OK")
    print("input:", tuple(x.shape))
    print("feature_map:", tuple(out["feature_map"].shape))
    print("temporal_context:", tuple(out["temporal_context"].shape))
